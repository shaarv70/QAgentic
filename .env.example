# --- Provider selection ---
# Options: groq | ollama | claude_cli
#
# claude_cli:
#   Routes LLM calls through the locally available Claude Code CLI.
#   QAgentic does NOT call the Anthropic API directly.
#
#   Before using claude_cli, the company-provided Claude/MARS
#   authentication/setup must already be completed.
LLM_PROVIDER=groq


# --- Model override (optional) ---
# If set, ALL agent profiles use this model name.
# Must match the model naming convention supported by the selected provider.
#
# groq      : e.g. llama-3.3-70b-versatile
# ollama    : e.g. llama3.2
# claude_cli: e.g. claude-sonnet-4-6
#
# Leave empty to use the provider-specific default model.
MODEL_NAME=


# --- Groq ---
# Required when LLM_PROVIDER=groq
GROQ_API_KEY=


# --- Ollama ---
# Required when LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434/api/generate


# --- General ---
LOG_LEVEL=INFO
OUTPUT_FOLDER=output


# --- Execution timeout ---
# Maximum seconds a test command is allowed to run before QAgentic
# kills the process and returns a FAILED result.
# Default: 1800 (30 min) — accommodates long-running Playwright/Selenium suites.
# Playwright's own per-test timeout (playwright.config.ts test_timeout_ms) can
# exceed 10 minutes; set this at least as high as your slowest expected suite.
EXECUTION_TIMEOUT_SECONDS=1800


# --- Page inspection strategy ---
# mcp  (default): Use Playwright MCP for a full accessibility tree.
#                 Falls back automatically to HTTP if MCP fails or returns empty.
# http           : Skip Playwright entirely — fetch page HTML directly via
#                 requests + stdlib HTML parsing. Faster, no browser required,
#                 works for SSR / static pages and behind corporate proxies.
PAGE_INSPECTION_STRATEGY=mcp


# --- Playwright MCP ---
# Set PLAYWRIGHT_MCP_ENABLED=false to disable Playwright MCP integration.
# Set PLAYWRIGHT_MCP_HEADLESS=false to show the browser during page inspection.
# Requires: npx (Node.js must be installed)
PLAYWRIGHT_MCP_ENABLED=true
PLAYWRIGHT_MCP_HEADLESS=true


# --- GitHub MCP ---
# GITHUB_MCP_TRANSPORT controls how QAgentic connects to GitHub MCP:
#   stdio (default): npx @modelcontextprotocol/server-github + GITHUB_PERSONAL_ACCESS_TOKEN
#   streamable-http: GitHub Copilot MCP endpoint (requires Copilot auth, no PAT needed)
#
# For stdio transport, create a GitHub Personal Access Token at:
#   https://github.com/settings/tokens
# and grant it: repo, read:org, read:user
GITHUB_MCP_TRANSPORT=stdio
GITHUB_PERSONAL_ACCESS_TOKEN=

# For streamable-http transport (GitHub Copilot):
# GITHUB_MCP_TRANSPORT=streamable-http
# GITHUB_COPILOT_MCP_URL=https://api.githubcopilot.com/mcp/


# --- Workspace retention ---
# Cloned repositories are stored under .qagentic/workspaces/.
# These settings control automatic pruning at startup.
#
# WORKSPACE_TTL_DAYS    : delete workspaces older than N days  (0 = disabled, default 7)
# WORKSPACE_MAX_COUNT   : keep only the N most recent workspaces (0 = disabled, default 20)
# WORKSPACE_MAX_SIZE_MB : prune oldest workspaces when total size exceeds N MB (0 = disabled, default 500)
WORKSPACE_TTL_DAYS=7
WORKSPACE_MAX_COUNT=20
WORKSPACE_MAX_SIZE_MB=500